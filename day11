#merging tabulate with file
from tabulate import tabulate
title=["Name","Age","Dept"]
data=[["Raj",19,"CSE"],
      ["Sonal",20,"CSE"],
      ["Meera",45,"AIML"],
      ["Anil",34,"MECH"]]
res=tabulate(data,headers=title,tablefmt="pretty")
with open("Sonal.txt",'w') as file:
    file.write(res)
print("Done")    

#fetching data from file
a=open("Sonal.txt",'r')
c=a.readlines()
while c:
    print(c)
    c=a.readlines()
a.close()   

#stack implementation
class Stack:
    def __init__(self):
        self.l=[]
    def push(self,a):
        self.l.append(a)
    def pop(self):
        self.l.pop()
    def display(self):
        b="->".join(map(str,self.l))
        print(b)
    def peek(self):
        print(self.l[-1])
s=Stack()
s.push(100)
s.push(200)
s.push(300)
s.display()
s.pop()
s.display()
s.peek()
